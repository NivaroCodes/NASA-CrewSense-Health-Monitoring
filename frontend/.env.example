# Copy to .env.local and adjust. Vite reads .env.local; do not commit real values.

# Backend API base URL (API contract, section 0).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional reference time for reproducible Mission Day 087 demo (API contract, sections 3 and 11).
# Leave empty to use the server's current time.
# Demo only. Leave commented out for real use: a fixed reference time keeps the dashboard on the
# demo day, so a scan submitted today would not change what the dashboard shows.
# VITE_AS_OF=2026-11-13T07:30:00Z
